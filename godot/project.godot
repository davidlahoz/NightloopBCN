; NIGHTLOOP — Godot port (from the Babylon.js WebGPU demo).
; Engine: Godot 4.7, Forward+.

config_version=5

[application]

config/name="NightLoop"
config/description="Endless procedural night city driving."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

TrafficManager="*res://scripts/traffic/traffic_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

